{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/kevlns/figma-to-uprefab/schemas/project-config.schema.json",
  "title": "figma-to-uprefab tracked project config",
  "description": "Tracked, machine-independent Unity project configuration. Credentials and absolute project paths are forbidden.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "unity", "staging"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "unity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "editorPath": {
          "type": "string",
          "minLength": 1,
          "description": "Optional local Unity Editor executable override. Prefer the ignored local config for machine-specific values."
        }
      }
    },
    "staging": {
      "type": "object",
      "required": ["root"],
      "additionalProperties": false,
      "properties": {
        "root": {
          "type": "string",
          "pattern": "^Assets/(?:.*/)?_Staging(?:/.*)?$",
          "description": "Project-relative staging root inside an Assets/**/_Staging directory."
        }
      }
    },
    "baseUiPrefab": { "$ref": "#/definitions/prefabPath" },
    "textPrefab": { "$ref": "#/definitions/prefabPath" },
    "specialListPrefab": { "$ref": "#/definitions/prefabPath" },
    "specialGridPrefab": { "$ref": "#/definitions/prefabPath" },
    "formalPrefabRoot": { "$ref": "#/definitions/assetsDirectory" },
    "formalSpriteRoot": { "$ref": "#/definitions/assetsDirectory" },
    "tagMappings": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/tagMapping" }
    },
    "translations": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    }
  },
  "definitions": {
    "prefabPath": {
      "type": "string",
      "pattern": "^Assets/.+\\.prefab$"
    },
    "assetsDirectory": {
      "type": "string",
      "pattern": "^Assets/.+"
    },
    "tagMapping": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "unityType"],
          "properties": {
            "kind": { "const": "component" },
            "unityType": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "prefabPath"],
          "properties": {
            "kind": { "const": "prefab" },
            "prefabPath": { "$ref": "#/definitions/prefabPath" }
          }
        }
      ]
    }
  }
}
