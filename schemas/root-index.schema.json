{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/kevlns/figma-to-uprefab/schemas/root-index.schema.json",
  "title": "figma-to-uprefab root index",
  "description": "_Staging/figma-roots.index.json: one entry per discovered [root], with canonical Meta/ paths.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "source", "roots"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileKey", "discovery"],
      "properties": {
        "fileKey": { "type": "string", "minLength": 1 },
        "discovery": { "const": "all-tagged-roots" }
      }
    },
    "roots": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/root" }
    }
  },
  "definitions": {
    "root": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "figmaNodeId",
        "figmaName",
        "prefabName",
        "pageNodeId",
        "pageName",
        "visible",
        "sourceManifestPath",
        "irPath",
        "stagingPath"
      ],
      "properties": {
        "figmaNodeId": { "type": "string", "minLength": 1 },
        "figmaName": { "type": "string" },
        "prefabName": { "type": "string", "minLength": 1 },
        "pageNodeId": { "type": "string", "minLength": 1 },
        "pageName": { "type": "string" },
        "visible": { "type": "boolean" },
        "sourceManifestPath": { "type": "string", "minLength": 1 },
        "irPath": { "type": "string", "minLength": 1 },
        "stagingPath": { "type": "string", "minLength": 1 }
      }
    }
  }
}
