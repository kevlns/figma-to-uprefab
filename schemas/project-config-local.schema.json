{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/kevlns/figma-to-uprefab/schemas/project-config-local.schema.json",
  "title": "figma-to-uprefab ignored local overrides",
  "description": "Machine-local non-secret overrides. figmaAccessToken and projectPath are rejected by additionalProperties:false.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "unity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "editorPath": { "type": "string", "minLength": 1 }
      }
    },
    "staging": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "root": { "type": "string", "pattern": "^Assets/(?:.*/)?_Staging(?:/.*)?$" }
      }
    },
    "baseUiPrefab": { "type": "string", "pattern": "^Assets/.+\\.prefab$" },
    "textPrefab": { "type": "string", "pattern": "^Assets/.+\\.prefab$" },
    "specialListPrefab": { "type": "string", "pattern": "^Assets/.+\\.prefab$" },
    "specialGridPrefab": { "type": "string", "pattern": "^Assets/.+\\.prefab$" },
    "formalPrefabRoot": { "type": "string", "pattern": "^Assets/.+" },
    "formalSpriteRoot": { "type": "string", "pattern": "^Assets/.+" },
    "tagMappings": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "unityType"],
            "properties": {
              "kind": { "const": "component" },
              "unityType": { "type": "string", "minLength": 1 }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "prefabPath"],
            "properties": {
              "kind": { "const": "prefab" },
              "prefabPath": { "type": "string", "pattern": "^Assets/.+\\.prefab$" }
            }
          }
        ]
      }
    },
    "translations": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    }
  }
}
