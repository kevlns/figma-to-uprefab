{
  "schemaVersion": 1,
  "package": "@kevlns/figma-to-uprefab",
  "command": "figma",
  "bin": "figma-to-uprefab",
  "description": "将 Figma 标记画板导出为源数据和图片，通过 Unity 转换器生成 UGUI 预制体。",
  "platforms": [
    "win32"
  ],
  "runtime": {
    "node": ">=20",
    "os": "win32"
  },
  "environment": [
    {
      "name": "FIGMA_ACCESS_TOKEN",
      "description": "Figma 令牌，要求 file_content:read；优先于用户配置中的 figmaAccessToken。令牌不进入版本库，日志脱敏。"
    },
    {
      "name": "FIGMA_TO_UPREFAB_CONFIG",
      "description": "指定用户配置路径，默认 ~/.config/figma-to-uprefab/config.json。"
    },
    {
      "name": "ProgramFiles / LOCALAPPDATA",
      "description": "未指定 unity.editorPath 时，通过 Unity Hub 的 Editor/<version>/Editor/Unity.exe 定位编辑器。"
    }
  ],
  "agent": {
    "whenToUse": "导出 Figma 标记画板，校验源清单与图片，在 Unity 中生成暂存 UGUI 预制体；不将产物直接转入运行时目录或写入 UIConfig。",
    "globalOptions": [
      {
        "flags": "-V, --version",
        "description": "output the version number"
      },
      {
        "flags": "-h, --help",
        "description": "display help for command"
      },
      {
        "flags": "--json",
        "description": "输出结构化回执；构建进度写入 stderr。"
      }
    ],
    "commands": [
      {
        "path": [
          "setup"
        ],
        "usage": "figma-to-uprefab setup <project> [options]",
        "description": "将工程配置写入 ~/.config/figma-to-uprefab/config.json，不修改工程。",
        "arguments": [
          {
            "name": "project",
            "required": true,
            "description": "Unity 工程路径。"
          }
        ],
        "options": [
          {
            "flags": "--config <path>",
            "description": "用户配置的明确路径。"
          },
          {
            "flags": "-f, --force",
            "description": "覆盖已有工程配置。"
          }
        ],
        "output": {
          "format": "text",
          "description": "返回用户配置路径及工程键。"
        },
        "exitCodes": {
          "0": "成功。",
          "1": "失败。"
        },
        "safety": [
          "只写入用户配置，不修改 Unity 资源。"
        ]
      },
      {
        "path": [
          "config",
          "init"
        ],
        "usage": "figma-to-uprefab config init [options]",
        "description": "创建工程配置，默认 uiSystem 为 UGUI，不写入令牌字段。",
        "arguments": [],
        "options": [
          {
            "flags": "--project <path>",
            "description": "Unity 工程路径，默认当前目录。"
          },
          {
            "flags": "--config <path>",
            "description": "用户配置的明确路径。"
          },
          {
            "flags": "-f, --force",
            "description": "覆盖已有工程配置。"
          }
        ],
        "output": {
          "format": "text",
          "description": "返回用户配置路径和工程键。"
        },
        "exitCodes": {
          "0": "成功。",
          "1": "失败。"
        },
        "safety": [
          "只写入用户配置。"
        ]
      },
      {
        "path": [
          "config",
          "validate"
        ],
        "usage": "figma-to-uprefab config validate [options]",
        "description": "按 schema 校验工程配置、令牌和 uiSystem；环境变量令牌优先，非 UGUI 值拒绝执行。",
        "arguments": [],
        "options": [
          {
            "flags": "--project <path>",
            "description": "Unity 工程路径。"
          },
          {
            "flags": "--config <path>",
            "description": "用户配置的明确路径。"
          }
        ],
        "output": {
          "format": "text",
          "description": "返回配置有效性及结构、配置段、令牌和界面系统问题。"
        },
        "exitCodes": {
          "0": "有效。",
          "1": "无效。"
        },
        "safety": [
          "只读。",
          "不输出令牌。"
        ]
      },
      {
        "path": [
          "config",
          "migrate"
        ],
        "usage": "figma-to-uprefab config migrate [options]",
        "description": "将指定工程配置转换到用户配置文件，并重命名来源文件为 *.migrated；不复制令牌。",
        "arguments": [],
        "options": [
          {
            "flags": "--project <path>",
            "description": "Unity 工程路径。"
          },
          {
            "flags": "--config <path>",
            "description": "用户配置的明确路径。"
          },
          {
            "flags": "-f, --force",
            "description": "覆盖已有工程配置。"
          }
        ],
        "output": {
          "format": "text",
          "description": "返回工程键与已重命名的来源文件列表。"
        },
        "exitCodes": {
          "0": "成功。",
          "1": "转换失败：无可转换数据、未明确覆盖现有配置或合并结果无效。"
        },
        "safety": [
          "写入用户配置，并在原位置重命名来源配置文件。",
          "不从来源配置复制 figmaAccessToken。"
        ]
      },
      {
        "path": [
          "export"
        ],
        "usage": "figma-to-uprefab export <fileKey> [options]",
        "description": "从 Figma REST 导出源清单、节点 PNG 和根索引，只写入暂存目录。",
        "arguments": [
          {
            "name": "fileKey",
            "required": true,
            "description": "Figma 文件标识。"
          }
        ],
        "options": [
          {
            "flags": "--project <path>",
            "description": "Unity 工程路径。"
          },
          {
            "flags": "--config <path>",
            "description": "用户配置的明确路径。"
          },
          {
            "flags": "--discovery-document <path>",
            "description": "测试输入：已捕获的 GET /v1/files/:key 响应。"
          },
          {
            "flags": "--node-documents <dir>",
            "description": "测试输入：从 <safe-id>.json 读取节点文档。"
          },
          {
            "flags": "--discovery-only",
            "description": "只发现根节点，不请求节点文档或图片。"
          },
          {
            "flags": "--image-scale <n>",
            "description": "图片导出倍率，范围 0.01–4.0。"
          }
        ],
        "output": {
          "format": "text",
          "description": "返回发现的根节点数量和根索引路径。"
        },
        "exitCodes": {
          "0": "成功。",
          "1": "令牌缺失、请求失败或节点发现不符合要求。"
        },
        "safety": [
          "只写入配置的暂存根目录。",
          "令牌不进入日志或源清单。",
          "请求有超时和有界 429/5xx 重试；文件原子写入，拒绝路径越界。"
        ]
      },
      {
        "path": [
          "contract"
        ],
        "usage": "figma-to-uprefab contract [options]",
        "description": "只读校验暂存目录、schema 和路径约束。",
        "arguments": [],
        "options": [
          {
            "flags": "--project <path>",
            "description": "Unity 工程路径。"
          },
          {
            "flags": "--config <path>",
            "description": "用户配置的明确路径。"
          },
          {
            "flags": "--index <path>",
            "description": "指定根索引路径。"
          },
          {
            "flags": "--allow-missing-ir",
            "description": "将 IR 缺失报告为警告。"
          }
        ],
        "output": {
          "format": "text",
          "description": "返回契约有效性和 CON_* 问题列表。"
        },
        "exitCodes": {
          "0": "有效。",
          "1": "无效。"
        },
        "safety": [
          "只读，不修改 Unity 工程。"
        ]
      },
      {
        "path": [
          "doctor"
        ],
        "usage": "figma-to-uprefab doctor [options]",
        "description": "只读检查配置、暂存数据、Unity 转换器、编辑器与令牌状态。",
        "arguments": [],
        "options": [
          {
            "flags": "--project <path>",
            "description": "Unity 工程路径。"
          },
          {
            "flags": "--config <path>",
            "description": "用户配置的明确路径。"
          }
        ],
        "output": {
          "format": "text",
          "description": "逐项返回 ok/FAIL 检查结果；令牌只显示是否存在。"
        },
        "exitCodes": {
          "0": "所有检查通过。",
          "1": "至少一项检查失败。"
        },
        "safety": [
          "只读。",
          "令牌脱敏，不输出其内容。"
        ]
      },
      {
        "path": [
          "agent",
          "docs"
        ],
        "usage": "figma-to-uprefab agent docs [options]",
        "description": "输出或导出随包 AGENTS.md，不安装技能。",
        "arguments": [],
        "options": [
          {
            "flags": "-o, --out <path>",
            "description": "将文档写入文件。"
          }
        ],
        "output": {
          "format": "text",
          "description": "返回 AGENTS.md 内容或文件路径。"
        },
        "exitCodes": {
          "0": "成功。",
          "1": "失败。"
        },
        "safety": [
          "只提供文档，不安装技能。"
        ]
      },
      {
        "path": [
          "unity",
          "install"
        ],
        "usage": "figma-to-uprefab unity install [options]",
        "description": "将 com.kevlns.figma-to-uprefab 安装到工程；支持预演、哈希回执、改动检测、原子替换与回滚。",
        "arguments": [],
        "options": [
          {
            "flags": "--project <path>",
            "description": "Unity 工程路径。"
          },
          {
            "flags": "--config <path>",
            "description": "用户配置的明确路径。"
          },
          {
            "flags": "--dry-run",
            "description": "校验并预演，不写入文件。"
          },
          {
            "flags": "-f, --force",
            "description": "明确覆盖已有安装或修改检测结果。"
          }
        ],
        "output": {
          "format": "text",
          "description": "返回状态、包目录、文件数量及回执路径。"
        },
        "exitCodes": {
          "0": "成功。",
          "1": "工程无效，或已修改的安装未获明确覆盖授权。"
        },
        "safety": [
          "只写入 <project>/Packages/com.kevlns.figma-to-uprefab 和 Library/figma-to-uprefab 回执。",
          "回执记录完整文件树哈希；检测到改动时拒绝执行。",
          "先暂存再替换；备份已有安装，失败时恢复。"
        ]
      },
      {
        "path": [
          "unity",
          "status"
        ],
        "usage": "figma-to-uprefab unity status [options]",
        "description": "检查转换器是否安装、文件是否与回执一致。",
        "arguments": [],
        "options": [
          {
            "flags": "--project <path>",
            "description": "Unity 工程路径。"
          },
          {
            "flags": "--config <path>",
            "description": "用户配置的明确路径。"
          }
        ],
        "output": {
          "format": "text",
          "description": "返回 installed、modified 和包路径。"
        },
        "exitCodes": {
          "0": "成功。",
          "1": "失败。"
        },
        "safety": [
          "只读。"
        ]
      },
      {
        "path": [
          "unity",
          "uninstall"
        ],
        "usage": "figma-to-uprefab unity uninstall [options]",
        "description": "移除转换器；安装内容被修改时拒绝执行，除非明确指定 --force。",
        "arguments": [],
        "options": [
          {
            "flags": "--project <path>",
            "description": "Unity 工程路径。"
          },
          {
            "flags": "--config <path>",
            "description": "用户配置的明确路径。"
          },
          {
            "flags": "--dry-run",
            "description": "预演，不写入文件。"
          },
          {
            "flags": "-f, --force",
            "description": "移除已修改的安装内容。"
          }
        ],
        "output": {
          "format": "text",
          "description": "返回 Uninstalled、NotInstalled、DryRun 或 ModifiedRejected。"
        },
        "exitCodes": {
          "0": "成功。",
          "1": "失败，可能返回 ModifiedRejected。"
        },
        "safety": [
          "安装内容被修改时拒绝卸载，除非明确指定 --force。"
        ]
      },
      {
        "path": [
          "build"
        ],
        "usage": "figma-to-uprefab build [options]",
        "description": "通过 Unity 批处理运行 C# 转换器；未安装、回执缺失或编辑器占用时拒绝执行。",
        "arguments": [],
        "options": [
          {
            "flags": "--project <path>",
            "description": "Unity 工程路径。"
          },
          {
            "flags": "--config <path>",
            "description": "用户配置的明确路径。"
          },
          {
            "flags": "--index <path>",
            "description": "指定根索引路径。"
          },
          {
            "flags": "--allow-running-editor",
            "description": "明确允许编辑器运行时继续操作。"
          }
        ],
        "output": {
          "format": "json",
          "description": "返回报告路径及各根节点的 errorCode、errorMessage、转换和构建结果。"
        },
        "exitCodes": {
          "0": "所有根节点构建完成。",
          "1": "转换器或回执缺失、编辑器占用或根节点构建失败。"
        },
        "safety": [
          "只写入 Library/figma-to-uprefab 下的请求、报告与暂存产物。",
          "构建结果必须来自 Unity 退出码和报告 JSON。"
        ]
      }
    ]
  }
}
